# 多链区块链浏览器API密钥配置示例
# 复制此文件为 .env 并填入你的实际API密钥

# 通用API密钥（适用于所有网络，必需）
ETHERSCAN_API_KEY=YourEtherscanApiKeyHere

# 网络特定API密钥（可选，优先级更高）
# 以太坊主网 - api.etherscan.io
ETHERSCAN_API_KEY=YourEtherscanApiKeyHere

# Arbitrum One - api.arbiscan.io  
ARBISCAN_API_KEY=YourArbiscanApiKeyHere

# Base 网络 - api.basescan.org
BASESCAN_API_KEY=YourBasescanApiKeyHere

# BSC (BNB Smart Chain) - api.bscscan.com
BSCSCAN_API_KEY=YourBscscanApiKeyHere

# 自定义RPC端点（可选）
WEB3_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# Robinhood Chain / NVDA3L mint monitor（可选）
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# 大批量历史扫描可配置多个节点，逗号分隔；优先于 ROBINHOOD_RPC_URL
# ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>,https://<ENDPOINT>.robinhood-mainnet.quiknode.pro/<TOKEN>
# RH_RPC_URLS 也可作为兼容变量名
# 也支持分别配置第三方节点；程序会按 RPC_ENV_NAMES 顺序轮询。请先在供应商控制台
# 手动创建 Robinhood Chain 主网（Chain ID 4663）endpoint，再粘贴完整地址；不要填写示例占位符。
# ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
# TATUM_RPC_URL=https://robinhood-mainnet.gateway.tatum.io
# QUICKNODE_RPC_URL=https://<ENDPOINT>.robinhood-mainnet.quiknode.pro/<TOKEN>
# BLOCKDAEMON_RPC_URL=
# DRPC_RPC_URL=
# VALIDATION_CLOUD_RPC_URL=
# CHAINSTACK_RPC_URL=
# GLOBALSTAKE_RPC_URL=
ROBINHOOD_BLOCKSCOUT_API_KEY=YourBlockscoutApiKeyHere

# Supabase Robinhood RWA 小时统计（仅 Worker 使用 service role key）
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
# 新版 Supabase 项目也可使用 service-role 等价的 secret key；不要在 Worker 中使用 publishable key
# SUPABASE_SECRET_KEY=<SECRET_KEY>
NVDA3L_MONITOR_INTERVAL_SECONDS=60
NVDA3L_MINT_PROBE_AMOUNT=1
NVDA3L_MINT_STATUS_FILE=monitor_output/nvda3l_mint_status.json

# 告警接口：同时配置对应的一组凭据即可启用
# TELEGRAM_BOT_TOKEN=YourTelegramBotToken
# TELEGRAM_CHAT_ID=YourTelegramChatId
# PUSHOVER_APP_TOKEN=YourPushoverAppToken
# PUSHOVER_USER_KEY=YourPushoverUserKey

# 注意事项：
# 1. 如果没有配置特定网络的API密钥，会自动回退使用 ETHERSCAN_API_KEY
# 2. 大部分区块链浏览器都兼容 Etherscan API 格式
# 3. 建议为每个网络申请专用API密钥以获得更高的请求限制
